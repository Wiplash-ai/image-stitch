{
  "manifest_version": 3,
  "name": "GlassWare",
  "version": "0.4.0",
  "description": "Capture images and pages into a private, local-first creative workbench.",
  "homepage_url": "https://labs.wiplash.ai/glassware",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "host_permissions": [
    "https://api.openverse.org/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capture with GlassWare",
    "default_popup": "popup.html"
  }
}
