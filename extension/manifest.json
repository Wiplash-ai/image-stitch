{
  "manifest_version": 3,
  "name": "ImageStitch",
  "version": "0.1.0",
  "description": "Capture images and pages into a private, local-first creative workbench.",
  "homepage_url": "https://labs.wiplash.ai/image-stitch",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capture with ImageStitch",
    "default_popup": "popup.html"
  }
}
