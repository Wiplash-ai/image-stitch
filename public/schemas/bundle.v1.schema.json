{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagestitch.dev/schemas/bundle.v1.schema.json",
  "title": "ImageStitch portable project bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "exportedAt", "project", "assets"],
  "properties": {
    "schemaVersion": { "const": "imagestitch.bundle.v1" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "project": { "$ref": "project.v1.schema.json" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "projectId", "name", "mimeType", "size", "width", "height", "createdAt", "dataUrl"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/gif"] },
          "size": { "type": "integer", "minimum": 0 },
          "width": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "height": { "type": "integer", "minimum": 1, "maximum": 32768 },
          "createdAt": { "type": "string", "format": "date-time" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "sourceUrl", "license", "attribution"],
            "properties": {
              "provider": { "const": "openverse" },
              "sourceUrl": { "type": "string", "format": "uri" },
              "creator": { "type": "string", "maxLength": 500 },
              "creatorUrl": { "type": "string", "format": "uri" },
              "license": { "type": "string", "minLength": 1, "maxLength": 80 },
              "licenseUrl": { "type": "string", "format": "uri" },
              "attribution": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          },
          "dataUrl": { "type": "string", "pattern": "^data:image/(png|jpeg|webp|gif);base64," }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "name", "source", "license", "createdAt", "faces"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "family": { "type": "string", "minLength": 1, "maxLength": 240 },
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "source": { "enum": ["upload", "google"] },
          "sourceUrl": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1, "maxLength": 500 },
          "createdAt": { "type": "string", "format": "date-time" },
          "faces": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mimeType", "size", "style", "weight", "dataUrl"],
              "properties": {
                "mimeType": { "type": "string", "minLength": 1, "maxLength": 120 },
                "size": { "type": "integer", "minimum": 1 },
                "style": { "type": "string", "minLength": 1, "maxLength": 80 },
                "weight": { "type": "string", "minLength": 1, "maxLength": 80 },
                "unicodeRange": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "dataUrl": { "type": "string", "pattern": "^data:" }
              }
            }
          }
        }
      }
    }
  }
}
