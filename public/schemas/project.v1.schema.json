{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labs.wiplash.ai/glassware/schemas/project.v1.schema.json",
  "title": "GlassWare project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "residency", "createdAt", "updatedAt", "canvas", "objects", "revisions", "currentRevisionId"],
  "properties": {
    "schemaVersion": { "const": "glassware.project.v1" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "residency": { "const": "local" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/designNode" } },
    "revisions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/revision" } },
    "currentRevisionId": { "type": "string", "format": "uuid" }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width", "height", "background"],
      "properties": {
        "preset": { "enum": ["square", "portrait", "story", "landscape", "custom"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "background": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "designNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y", "width", "height", "rotation", "scaleX", "scaleY", "opacity", "visible", "locked"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["text", "shape", "image"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "text": { "type": "string" },
        "fill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 240 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontStyle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "align": { "enum": ["left", "center", "right"] },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "shape": { "enum": ["rect", "rounded-rect", "ellipse", "triangle", "diamond", "pentagon", "hexagon", "star", "heart", "speech-bubble", "line", "arrow"] },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "assetId": { "type": "string", "format": "uuid" },
        "crop": { "$ref": "#/$defs/crop" },
        "adjustments": { "$ref": "#/$defs/imageAdjustments" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text" } }, "required": ["kind"] },
          "then": { "required": ["text", "fill", "fontFamily", "fontSize", "fontStyle", "align", "lineHeight"] }
        },
        {
          "if": { "properties": { "kind": { "const": "shape" } }, "required": ["kind"] },
          "then": { "required": ["shape", "fill", "cornerRadius"] }
        },
        {
          "if": { "properties": { "kind": { "const": "image" } }, "required": ["kind"] },
          "then": { "required": ["assetId"] }
        }
      ]
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "imageAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness", "contrast", "saturation", "blur", "grayscale", "sepia"],
      "properties": {
        "brightness": { "type": "number", "minimum": -1, "maximum": 1 },
        "contrast": { "type": "number", "minimum": -100, "maximum": 100 },
        "saturation": { "type": "number", "minimum": -2, "maximum": 2 },
        "blur": { "type": "number", "minimum": 0, "maximum": 40 },
        "grayscale": { "type": "boolean" },
        "sepia": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "objects"],
      "properties": {
        "canvas": { "$ref": "#/$defs/canvas" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/designNode" } }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "createdAt", "summary", "snapshot"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "number": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      }
    }
  }
}
