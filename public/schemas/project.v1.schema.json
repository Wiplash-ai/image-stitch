{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagestitch.dev/schemas/project.v1.schema.json",
  "title": "ImageStitch project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "residency", "createdAt", "updatedAt", "canvas", "objects", "revisions", "currentRevisionId"],
  "properties": {
    "schemaVersion": { "const": "imagestitch.project.v1" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "residency": { "const": "local" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width", "height"],
      "properties": {
        "preset": { "enum": ["square", "portrait", "story", "landscape", "custom"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "objects": { "type": "array", "items": { "type": "object" } },
    "revisions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "currentRevisionId": { "type": "string", "format": "uuid" }
  }
}
