{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labs.wiplash.ai/glassware/schemas/project.v1.schema.json",
  "title": "GlassWare project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "residency", "createdAt", "updatedAt", "canvas", "objects", "pages", "activePageId", "revisions", "currentRevisionId"],
  "properties": {
    "schemaVersion": { "const": "glassware.project.v1" },
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "residency": { "const": "local" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "objects": { "type": "array", "items": { "$ref": "#/$defs/designNode" } },
    "pages": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/designPage" } },
    "activePageId": { "type": "string", "format": "uuid" },
    "revisions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/revision" } },
    "currentRevisionId": { "type": "string", "format": "uuid" }
  },
  "$defs": {
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "width", "height", "background", "presentation", "guides", "showRulers", "snapping"],
      "properties": {
        "preset": { "enum": ["square", "portrait", "story", "landscape", "custom"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "background": { "type": "string", "minLength": 1, "maxLength": 128 },
        "presentation": { "$ref": "#/$defs/artworkPresentation" },
        "guides": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "axis", "position"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "axis": { "enum": ["x", "y"] },
              "position": { "type": "number", "minimum": -16384, "maximum": 32768 }
            }
          }
        },
        "showRulers": { "type": "boolean" },
        "snapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "canvas", "objects", "guides", "threshold"],
          "properties": {
            "enabled": { "type": "boolean" },
            "canvas": { "type": "boolean" },
            "objects": { "type": "boolean" },
            "guides": { "type": "boolean" },
            "threshold": { "type": "number", "minimum": 1, "maximum": 64 }
          }
        }
      }
    },
    "designNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "x", "y", "width", "height", "rotation", "scaleX", "scaleY", "opacity", "visible", "locked"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "enum": ["text", "shape", "image"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "groupId": { "type": "string", "format": "uuid" },
        "blendMode": { "enum": ["source-over", "multiply", "screen", "overlay", "darken", "lighten", "color-dodge", "color-burn", "hard-light", "soft-light", "difference", "exclusion"] },
        "text": { "type": "string" },
        "fill": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fontFamily": { "type": "string", "minLength": 1, "maxLength": 240 },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontStyle": { "type": "string", "minLength": 1, "maxLength": 80 },
        "align": { "enum": ["left", "center", "right"] },
        "lineHeight": { "type": "number", "exclusiveMinimum": 0 },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "color", "blur", "offsetX", "offsetY", "opacity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "blur": { "type": "number", "minimum": 0, "maximum": 200 },
            "offsetX": { "type": "number", "minimum": -200, "maximum": 200 },
            "offsetY": { "type": "number", "minimum": -200, "maximum": 200 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "shape": { "enum": ["rect", "rounded-rect", "ellipse", "triangle", "diamond", "pentagon", "hexagon", "star", "heart", "speech-bubble", "line", "arrow", "curved-arrow", "blur", "redact"] },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "assetId": { "type": "string", "format": "uuid" },
        "crop": { "$ref": "#/$defs/crop" },
        "adjustments": { "$ref": "#/$defs/imageAdjustments" },
        "presentation": { "$ref": "#/$defs/imagePresentation" },
        "mask": { "$ref": "#/$defs/imageMask" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "text" } }, "required": ["kind"] },
          "then": { "required": ["text", "fill", "fontFamily", "fontSize", "fontStyle", "align", "lineHeight", "shadow"] }
        },
        {
          "if": { "properties": { "kind": { "const": "shape" } }, "required": ["kind"] },
          "then": { "required": ["shape", "fill", "cornerRadius", "shadow"] }
        },
        {
          "if": { "properties": { "kind": { "const": "image" } }, "required": ["kind"] },
          "then": { "required": ["assetId", "crop", "adjustments", "presentation", "mask"] }
        }
      ]
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "imageAdjustments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brightness", "contrast", "saturation", "temperature", "tint", "sharpen", "vignette", "blur", "grayscale", "sepia"],
      "properties": {
        "brightness": { "type": "number", "minimum": -1, "maximum": 1 },
        "contrast": { "type": "number", "minimum": -100, "maximum": 100 },
        "saturation": { "type": "number", "minimum": -2, "maximum": 2 },
        "temperature": { "type": "number", "minimum": -1, "maximum": 1 },
        "tint": { "type": "number", "minimum": -1, "maximum": 1 },
        "sharpen": { "type": "number", "minimum": 0, "maximum": 1 },
        "vignette": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur": { "type": "number", "minimum": 0, "maximum": 40 },
        "grayscale": { "type": "boolean" },
        "sepia": { "type": "boolean" }
      }
    },
    "imageMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "inverted", "feather", "strokes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "inverted": { "type": "boolean" },
        "feather": { "type": "number", "minimum": 0, "maximum": 100 },
        "strokes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "mode", "size", "points"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 160 },
              "mode": { "enum": ["hide", "reveal"] },
              "size": { "type": "number", "minimum": 0.001, "maximum": 1 },
              "points": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4000,
                "items": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "imagePresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cornerRadius", "frame", "shadow"],
      "properties": {
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 500 },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "width", "color", "opacity", "padding", "title"],
          "properties": {
            "type": { "enum": ["none", "arc-light", "arc-dark", "macos-light", "macos-dark", "windows-light", "windows-dark", "photograph", "glass-light", "glass-dark", "outline-light", "border-light", "border-dark"] },
            "width": { "type": "number", "minimum": 0, "maximum": 64 },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "padding": { "type": "number", "minimum": 0, "maximum": 256 },
            "title": { "type": "string", "maxLength": 240 }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "color", "blur", "offsetX", "offsetY", "opacity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "blur": { "type": "number", "minimum": 0, "maximum": 200 },
            "offsetX": { "type": "number", "minimum": -200, "maximum": 200 },
            "offsetY": { "type": "number", "minimum": -200, "maximum": 200 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "artworkPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "padding", "background", "backdrop", "cornerRadius", "frame", "shadow"],
      "properties": {
        "enabled": { "type": "boolean" },
        "padding": { "type": "number", "minimum": 0, "maximum": 4096 },
        "background": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backdrop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value", "opacity", "blur", "noise"],
          "properties": {
            "type": { "enum": ["solid", "gradient", "image"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 240 },
            "assetId": { "type": "string", "format": "uuid" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "blur": { "type": "number", "minimum": 0, "maximum": 100 },
            "noise": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 500 },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "width", "color", "opacity", "padding", "title"],
          "properties": {
            "type": { "enum": ["none", "arc-light", "arc-dark", "macos-light", "macos-dark", "windows-light", "windows-dark", "photograph", "glass-light", "glass-dark", "outline-light", "border-light", "border-dark"] },
            "width": { "type": "number", "minimum": 0, "maximum": 64 },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "padding": { "type": "number", "minimum": 0, "maximum": 256 },
            "title": { "type": "string", "maxLength": 240 }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "color", "blur", "offsetX", "offsetY", "opacity"],
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "type": "string", "minLength": 1, "maxLength": 128 },
            "blur": { "type": "number", "minimum": 0, "maximum": 200 },
            "offsetX": { "type": "number", "minimum": -200, "maximum": 200 },
            "offsetY": { "type": "number", "minimum": -200, "maximum": 200 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "objects"],
      "properties": {
        "canvas": { "$ref": "#/$defs/canvas" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/designNode" } }
      }
    },
    "designPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "canvas", "objects", "currentRevisionId"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "canvas": { "$ref": "#/$defs/canvas" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/designNode" } },
        "currentRevisionId": { "type": "string", "format": "uuid" }
      }
    },
    "projectDocumentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activePageId", "pages"],
      "properties": {
        "activePageId": { "type": "string", "format": "uuid" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/designPage" }
        }
      }
    },
    "aiProjectTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "before", "after"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "before": { "$ref": "#/$defs/projectDocumentState" },
        "after": { "$ref": "#/$defs/projectDocumentState" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "number", "createdAt", "summary", "snapshot"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "pageId": { "type": "string", "format": "uuid" },
        "number": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "aiProjectTransaction": { "$ref": "#/$defs/aiProjectTransaction" },
        "aiSessionId": { "type": "string", "format": "uuid" }
      }
    }
  }
}
